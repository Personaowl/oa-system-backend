<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.personaowl.oa.ai.infrastructure.mapper.AiKnowledgeChunkMapper">

    <resultMap id="BaseResultMap" type="com.personaowl.oa.ai.domain.entity.AiKnowledgeChunk">
        <id column="id" property="id"/>
        <result column="doc_id" property="docId"/>
        <result column="chunk_no" property="chunkNo"/>
        <result column="chunk_title" property="chunkTitle"/>
        <result column="chunk_text" property="chunkText"/>
        <result column="chunk_hash" property="chunkHash"/>
        <result column="vector_key" property="vectorKey"/>
        <result column="metadata_json" property="metadataJson"/>
        <result column="embedding_model" property="embeddingModel"/>
        <result column="embedding_dim" property="embeddingDim"/>
        <result column="status" property="status"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <insert id="insertBatch">
        INSERT INTO ai_knowledge_chunk
        (doc_id, chunk_no, chunk_title, chunk_text, chunk_hash, vector_key, metadata_json, embedding_model, embedding_dim, status, created_at)
        VALUES
        <foreach collection="chunks" item="item" separator=",">
            (#{item.docId}, #{item.chunkNo}, #{item.chunkTitle}, #{item.chunkText}, #{item.chunkHash}, #{item.vectorKey}, #{item.metadataJson}, #{item.embeddingModel}, #{item.embeddingDim}, #{item.status}, #{item.createdAt})
        </foreach>
    </insert>

    <select id="selectByDocId" resultMap="BaseResultMap">
        SELECT * FROM ai_knowledge_chunk WHERE doc_id = #{docId} ORDER BY chunk_no ASC
    </select>

    <delete id="deleteByDocId">
        DELETE FROM ai_knowledge_chunk WHERE doc_id = #{docId}
    </delete>

</mapper>
